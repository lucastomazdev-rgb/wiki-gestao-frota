generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String   @id @default(uuid())
  email                   String   @unique
  passwordHash            String
  name                    String
  role                    Role     @default(USER)
  createdAt               DateTime @default(now())
  can_access_gestao_solar Boolean? @default(false)
  sessionVersion          Int      @default(0)
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  iconName    String    @default("BookOpen")
  createdAt   DateTime  @default(now())
  articles    Article[]
}

model Article {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  contentMarkdown String
  videoUrl        String?
  fileDownloadUrl String?
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model instalacoes {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descricao_veiculo    String?               @db.VarChar(255)
  modulo               String?               @db.VarChar(100)
  operacao             String?               @db.VarChar(100)
  placa                String                @unique(map: "uq_instalacoes_placa") @db.VarChar(30)
  data_instalacao      DateTime?             @db.Date
  unidade_id           Int?
  modelo_id            Int?
  criado_em            DateTime              @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  modelos_rastreadores modelos_rastreadores? @relation(fields: [modelo_id], references: [id], onUpdate: NoAction)
  unidades_clientes    unidades_clientes?    @relation(fields: [unidade_id], references: [id], onUpdate: NoAction)

  @@index([modelo_id], map: "idx_instalacoes_modelo_id")
  @@index([unidade_id], map: "idx_instalacoes_unidade_id")
}

model log_movimentacoes {
  id                                                                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placa                                                                     String             @db.VarChar(30)
  tipo                                                                      String             @default("TRANSFERENCIA") @db.VarChar(50)
  unidade_origem_id                                                         Int?
  unidade_destino_id                                                        Int?
  usuario_id                                                                String?
  data_movimentacao                                                         DateTime           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  criado_em                                                                 DateTime           @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  unidades_clientes_log_movimentacoes_unidade_destino_idTounidades_clientes unidades_clientes? @relation("log_movimentacoes_unidade_destino_idTounidades_clientes", fields: [unidade_destino_id], references: [id], onUpdate: NoAction)
  unidades_clientes_log_movimentacoes_unidade_origem_idTounidades_clientes  unidades_clientes? @relation("log_movimentacoes_unidade_origem_idTounidades_clientes", fields: [unidade_origem_id], references: [id], onUpdate: NoAction)

  @@index([data_movimentacao], map: "idx_log_mov_data")
  @@index([placa], map: "idx_log_mov_placa")
}

model modelos_rastreadores {
  id                Int           @id @default(autoincrement())
  nome_modelo       String        @db.VarChar(200)
  tipo_veiculo      String        @db.VarChar(100)
  valor_instalacao  Decimal?      @default(0) @db.Decimal(10, 2)
  valor_mensalidade Decimal?      @default(0) @db.Decimal(10, 2)
  criado_em         DateTime      @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  instalacoes       instalacoes[]
  retiradas         retiradas[]
}

model retiradas {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placa                String                @db.VarChar(30)
  status               String?               @default("Retirado") @db.VarChar(100)
  data_retirada        DateTime?             @db.Date
  unidade_id           Int?
  modelo_id            Int?
  motivo               String?
  criado_em            DateTime              @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  modelos_rastreadores modelos_rastreadores? @relation(fields: [modelo_id], references: [id], onUpdate: NoAction)
  unidades_clientes    unidades_clientes?    @relation(fields: [unidade_id], references: [id], onUpdate: NoAction)

  @@index([data_retirada], map: "idx_retiradas_data")
  @@index([placa], map: "idx_retiradas_placa")
}

model unidades_clientes {
  id                                                                        Int                 @id @default(autoincrement())
  nome_unidade                                                              String              @db.VarChar(200)
  cod_cliente                                                               Int?
  razao_social                                                              String?             @db.VarChar(300)
  uf                                                                        String?             @db.Char(2)
  criado_em                                                                 DateTime            @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  instalacoes                                                               instalacoes[]
  log_movimentacoes_log_movimentacoes_unidade_destino_idTounidades_clientes log_movimentacoes[] @relation("log_movimentacoes_unidade_destino_idTounidades_clientes")
  log_movimentacoes_log_movimentacoes_unidade_origem_idTounidades_clientes  log_movimentacoes[] @relation("log_movimentacoes_unidade_origem_idTounidades_clientes")
  retiradas                                                                 retiradas[]
}

enum Role {
  USER
  ADMIN
}

model bibliotecas_can {
  id           String    @id
  nome         String
  arquivo_nome String?
  arquivo_url  String?
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

model equipamentos_padrao {
  id         String    @id
  nome       String
  codigo     String
  status     String    @default("Ativo")
  finalidade String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model perfis_motos {
  nome         String    @id
  arquivo_nome String?
  arquivo_url  String?
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

model scripts_unidades {
  unidade      String    @id
  arquivo_nome String?
  arquivo_url  String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
}

model tecnicos_terceirizados {
  id                          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                        String   @db.VarChar(200)
  telefone                    String?  @db.VarChar(30)
  regiao                      String   @db.VarChar(150)
  homologado                  Boolean  @default(false)
  cnh_url                     String?
  cnh_nome                    String?
  comprovante_residencia_url  String?
  comprovante_residencia_nome String?
  ativo                       Boolean  @default(true)
  criado_em                   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  atualizado_em               DateTime @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @db.Timestamptz(6)

  servicos_precos            tecnico_servicos_precos[]
  equipamentos               tecnico_equipamentos[]
  movimentacoes_equipamentos tecnico_movimentacoes_equipamentos[]
  ordens_servicos            ordens_servicos_terceirizados[]

  @@index([nome], map: "idx_tecnicos_nome")
  @@index([regiao], map: "idx_tecnicos_regiao")
}

model tecnico_servicos_precos {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tecnico_id     String   @db.Uuid
  nome_servico   String   @db.VarChar(200)
  valor          Decimal  @db.Decimal(10, 2)
  gera_devolucao Boolean  @default(false)
  is_km          Boolean  @default(false)
  criado_em      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  tecnico         tecnicos_terceirizados          @relation(fields: [tecnico_id], references: [id], onDelete: Cascade)
  ordens_servicos ordens_servicos_terceirizados[]

  @@unique([tecnico_id, nome_servico], map: "uq_tecnico_servico_nome")
  @@index([tecnico_id], map: "idx_tecnico_servicos_tecnico_id")
}

model tecnico_equipamentos {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tecnico_id         String   @db.Uuid
  modelo_equipamento String   @db.VarChar(150)
  quantidade         Int      @default(0)
  atualizado_em      DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  tecnico tecnicos_terceirizados @relation(fields: [tecnico_id], references: [id], onDelete: Cascade)

  @@unique([tecnico_id, modelo_equipamento], map: "idx_tecnico_modelo_unique")
}

model tecnico_movimentacoes_equipamentos {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tecnico_id         String   @db.Uuid
  modelo_equipamento String   @db.VarChar(150)
  tipo               String   @db.VarChar(50)
  quantidade         Int
  motivo_ou_os       String?  @db.VarChar(255)
  criado_em          DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)

  tecnico tecnicos_terceirizados @relation(fields: [tecnico_id], references: [id], onDelete: Cascade)

  @@index([tecnico_id, criado_em], map: "idx_mov_equip_tecnico_data")
}

model ordens_servicos_terceirizados {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero_os               String    @db.VarChar(100)
  tecnico_id              String    @db.Uuid
  servico_id              String?   @db.Uuid
  placa                   String    @db.VarChar(30)
  uf                      String?   @db.Char(2)
  unidade                 String?   @db.VarChar(200)
  tipo_veiculo            String?   @db.VarChar(100)
  nome_servico            String    @db.VarChar(200)
  valor_servico           Decimal   @db.Decimal(10, 2)
  teve_km_rodado          Boolean   @default(false)
  km_quantidade           Decimal?  @default(0) @db.Decimal(10, 2)
  valor_km_unitario       Decimal?  @default(0) @db.Decimal(10, 2)
  valor_km_total          Decimal?  @default(0) @db.Decimal(10, 2)
  valor_total_cobrado     Decimal   @db.Decimal(10, 2)
  numero_nf               String?   @db.VarChar(100)
  status                  String    @default("Agendado") @db.VarChar(50)
  equipamentos_utilizados Json?
  exige_devolucao         Boolean   @default(false)
  equipamento_devolvido   Boolean   @default(false)
  data_devolucao          DateTime? @db.Timestamptz(6)
  usuario_devolucao       String?   @db.VarChar(200)
  criado_em               DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  atualizado_em           DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @updatedAt @db.Timestamptz(6)

  tecnico tecnicos_terceirizados   @relation(fields: [tecnico_id], references: [id], onDelete: Restrict)
  servico tecnico_servicos_precos? @relation(fields: [servico_id], references: [id], onDelete: SetNull)

  @@unique([tecnico_id, numero_os], map: "uq_os_tecnico_numero")
  @@index([tecnico_id], map: "idx_os_tecnico_id")
  @@index([servico_id], map: "idx_os_servico_id")
  @@index([placa], map: "idx_os_placa")
  @@index([status], map: "idx_os_status")
}
