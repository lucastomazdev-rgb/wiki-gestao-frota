# Supabase Connection details for Prisma
DATABASE_URL="postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[username]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT Auth Configuration (Em produção, defina uma chave secreta com ao menos 32 caracteres)
JWT_SECRET="generate-a-secure-random-key-here-min-32-chars"

# Obrigatório somente para criar o primeiro administrador (mínimo 32 caracteres).
# Pode ser removido do Render depois que o setup inicial estiver concluído.
INITIAL_SETUP_TOKEN="generate-a-different-one-time-key-min-32-chars"

# Storage privado. Nunca use nem exponha a service role no frontend.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"

# Express Port
PORT=5000

# Client Application URL (CORS) - Origens permitidas separadas por vírgula
CLIENT_URL="https://sua-wiki.vercel.app,http://localhost:5173"

# Node Environment ("development" ou "production")
NODE_ENV="development"
